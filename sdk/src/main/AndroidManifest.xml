<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ADR-0005 Decision 11: package visibility for the tester
         companion app. AGP merges this into the host application's
         manifest, so integrators do nothing — do not "fix" this by
         documenting a customer-side step. Without it, hosts targeting
         API 30+ cannot see the companion at all (resolveContentProvider
         returns null) and attestation silently never happens.
         The authority itself is exported without a permission; the
         SDK authenticates it by signing certificate instead. -->
    <queries>
        <package android:name="no.issuetracker.testers" />
    </queries>

    <application>
        <!-- fontScale|density|locale: Compose re-reads these without an
             activity recreation; recreating would destroy the one-shot
             ReportingSession handoff and the user's draft (audit M-3). -->
        <activity
            android:name=".ui.ReportActivity"
            android:exported="false"
            android:theme="@style/Theme.IssuetrackerSdk.Reporter"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|fontScale|density|locale" />

        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.IssuetrackerSdk.Reporter"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode" />

        <provider
            android:name=".internal.SdkInitProvider"
            android:authorities="${applicationId}.no.issuetracker.sdk.init"
            android:exported="false"
            android:initOrder="100" />
    </application>
</manifest>
