<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- TV-only host: no touchscreen, leanback launcher. required=false
         on leanback keeps the APK installable on phones too, which is
         handy for quick checks — the SDK picks the trigger from the
         runtime form factor either way. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:name=".SampleTvApplication"
        android:allowBackup="true"
        android:label="Issuetracker TV Sample"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Shows up in the Android TV / Fire TV launcher row.
                     No android:banner set — fine for emulator/sideload;
                     Play Store TV listing would require one. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
